      "user_profile": "object (optional: tracked user context)",
      "language_preference": "string (optional: detected or set language)"
    },
    "metadata": {
      "agent_name": "string",
      "timestamp": "string (ISO)",
      "sub_agent_used": "string (optional: which sub-agent was delegated to)"
    }
  },
